<!--
  Layer monochrome per Material You / Monet (Android 13+).
  Stesse forme del foreground ma silhouette piena, in nero, su sfondo trasparente:
  Android lo ricolorera' con i toni del wallpaper utente.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108"
    android:tint="#000000">

    <path
        android:fillColor="#000000"
        android:pathData="M 54,18 A 36,36 0 1,1 53.99,18 Z" />

    <!-- Linee "incise" via destination-out: usiamo path bianchi (verranno
         rimosse dal silhouette nero perche' tintate). Lasciamo invece tre solchi:
         simulati con rettangoli del colore di sfondo. -->
    <group>
        <clip-path android:pathData="M 54,18 A 36,36 0 1,1 53.99,18 Z" />
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M 38,40 C 46,38 62,38 70,40 L 70,44 C 62,42 46,42 38,44 Z" />
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M 36,50 C 48,47 60,47 72,50 L 72,54 C 60,51 48,51 36,54 Z" />
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M 38,60 L 70,60 L 70,64 L 38,64 Z" />
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M 38,69 L 70,69 L 70,73 L 38,73 Z" />
    </group>
</vector>
