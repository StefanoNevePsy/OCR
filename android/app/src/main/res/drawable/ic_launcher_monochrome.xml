<!--
  Layer monochrome per Material You / Monet (Android 13+).
  Android tinge tutta l'area opaca della drawable col colore del wallpaper:
  per creare le "fessure" delle righe serve un buco TRASPARENTE, non un fill
  bianco. Usiamo fillType="evenOdd" su un unico path: il cerchio + 4 rettangoli
  interni; le aree "annidate" diventano automaticamente trasparenti.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:fillColor="#FF000000"
        android:fillType="evenOdd"
        android:pathData="
            M 54,18 m -36,0 a 36,36 0 1,0 72,0 a 36,36 0 1,0 -72,0 Z
            M 38,40 L 70,40 L 70,44 L 38,44 Z
            M 36,50 L 72,50 L 72,54 L 36,54 Z
            M 38,60 L 70,60 L 70,64 L 38,64 Z
            M 38,69 L 70,69 L 70,73 L 38,73 Z
        " />
</vector>
