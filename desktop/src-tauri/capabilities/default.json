{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities richieste dall'app Dewarp.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "dialog:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "dewarp-server",
          "sidecar": true,
          "args": [
            "--host",
            "127.0.0.1",
            "--port",
            { "validator": "^[0-9]+$" }
          ]
        }
      ]
    },
    "shell:allow-kill",
    "shell:allow-spawn",
    "shell:allow-stdin-write"
  ]
}
